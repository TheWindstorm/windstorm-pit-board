#!/bin/sh
# Windstorm Pit Board (plan G6.1): run the launcher, which picks the version folder (G21.4).
# The same relative path works in the plugin folder and in the stable copy ($PITBOARD_HOME/bin).
P=python3
python3 -I -c pass </dev/null >/dev/null 2>&1 || P=python
exec "$P" -I "$(dirname "$0")/../pitboard/launch.py" "$@"
